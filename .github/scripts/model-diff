#!/usr/bin/env python3
"""Compare the C4 model of two Structurizr JSON exports.

Usage: model-diff BASE.json HEAD.json

Prints a human-readable report. The first line is the verdict
("Model changed: ..." or "Model unchanged."). Exit codes, like diff(1):
0 = model unchanged, 1 = model changed, 2 = error.

Only the `model` part of the workspace is compared. Views, styles,
documentation, decisions (ADRs), configuration and layout are ignored.

Normalisation, so that only real model changes count:
- Generated `id`s are dropped. Elements are keyed by type and hierarchical
  name path (e.g. `Container "Webshop/API"`, deployment elements are prefixed
  with their environment); relationships by source -> destination + description.
- Collections are sorted by these keys, tags and deployment groups are
  compared as sets, so pure reordering is not a change.
- Implied relationships (generated by Structurizr from an explicit one,
  marked with `linkedRelationshipId`) are dropped; the explicit relationship
  they come from is already compared.
- The `structurizr.dsl.identifier` property is dropped: it is the DSL
  variable name, renaming it does not change the architecture.
- Element-level `documentation` is dropped (it is documentation, not model).
- Empty values are dropped, so a missing and an empty attribute are equal.

Everything else counts as a model change: new/removed elements (including
deployment nodes, infrastructure nodes and instances), new/removed
relationships, and any change of name, description, technology, tags, url,
group, properties, perspectives, instances, ...
"""

import json
import sys

# Child element collections: JSON key -> element type shown in the report.
STATIC_COLLECTIONS = {
    "people": "Person",
    "softwareSystems": "Software System",
    "customElements": "Element",
    "containers": "Container",
    "components": "Component",
}
DEPLOYMENT_COLLECTIONS = {
    "deploymentNodes": "Deployment Node",
    "children": "Deployment Node",
    "infrastructureNodes": "Infrastructure Node",
    "softwareSystemInstances": "Software System Instance",
    "containerInstances": "Container Instance",
}
COLLECTIONS = {**STATIC_COLLECTIONS, **DEPLOYMENT_COLLECTIONS}

# Keys that are generated, structural (handled separately) or not model.
IGNORED_ELEMENT_KEYS = {
    "id",
    "relationships",
    "documentation",
    "softwareSystemId",
    "containerId",
    "instanceId",
} | set(COLLECTIONS)
IGNORED_RELATIONSHIP_KEYS = {"id", "sourceId", "destinationId", "linkedRelationshipId"}
IGNORED_PROPERTIES = {"structurizr.dsl.identifier"}
SET_VALUED_KEYS = {"tags", "deploymentGroups"}


def normalise_attributes(raw, ignored):
    result = {}
    for key, value in raw.items():
        if key in ignored:
            continue
        if key in SET_VALUED_KEYS:
            if isinstance(value, str):
                value = value.split(",")
            value = sorted({v.strip() for v in value if v.strip()})
        elif key == "properties":
            value = {k: v for k, v in sorted(value.items()) if k not in IGNORED_PROPERTIES}
        elif key == "perspectives":
            value = sorted(value, key=lambda p: json.dumps(p, sort_keys=True))
        if value in (None, "", [], {}):
            continue
        result[key] = value
    return result


def unique_key(key, taken, suffix):
    """Make `key` unique among `taken`, first with `suffix`, then a counter."""
    if key not in taken:
        return key
    candidate = f"{key} [{suffix}]" if suffix else key
    n = 2
    while candidate in taken:
        candidate = f"{key} [{suffix or ''}#{n}]"
        n += 1
    return candidate


def normalise(workspace):
    """Return ({element key: attributes}, {relationship key: attributes})."""
    model = workspace.get("model", {})
    elements = {}
    paths_by_id = {}  # generated id -> name path (e.g. "Webshop/API")
    keys_by_id = {}  # generated id -> element key (e.g. 'Container "Webshop/API"')
    raw_relationships = []

    def walk(raw, element_type, parent_path):
        if element_type.endswith("Instance"):
            ref = raw.get("softwareSystemId") or raw.get("containerId")
            name = "[" + paths_by_id.get(ref, f"unknown element {ref}") + "]"
        else:
            name = raw.get("name", "")
        path = f"{parent_path}/{name}" if parent_path else name
        key = unique_key(f'{element_type} "{path}"', elements, raw.get("instanceId"))
        elements[key] = normalise_attributes(raw, IGNORED_ELEMENT_KEYS)
        paths_by_id[raw.get("id")] = path
        keys_by_id[raw.get("id")] = key
        raw_relationships.extend(raw.get("relationships", []))
        for collection, child_type in COLLECTIONS.items():
            for child in raw.get(collection, []):
                walk(child, child_type, path)

    # Static elements first: instances in deployment nodes refer to them.
    for collection, element_type in STATIC_COLLECTIONS.items():
        for raw in model.get(collection, []):
            walk(raw, element_type, "")
    for raw in model.get("deploymentNodes", []):
        walk(raw, "Deployment Node", raw.get("environment", ""))

    model_attributes = normalise_attributes(model, set(COLLECTIONS))
    if model_attributes:
        elements["Model"] = model_attributes

    relationships = {}
    for raw in raw_relationships:
        if raw.get("linkedRelationshipId"):
            continue  # implied relationship
        source = keys_by_id.get(raw.get("sourceId"), f"unknown element {raw.get('sourceId')}")
        destination = keys_by_id.get(raw.get("destinationId"), f"unknown element {raw.get('destinationId')}")
        key = f'{source} -> {destination} "{raw.get("description", "")}"'
        key = unique_key(key, relationships, raw.get("technology"))
        relationships[key] = normalise_attributes(raw, IGNORED_RELATIONSHIP_KEYS)
    return elements, relationships


def fmt(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True)


def diff_section(kind, base, head):
    lines = []
    for key in sorted(set(base) | set(head)):
        if key not in base:
            lines.append(f"+ added {kind}: {key}")
        elif key not in head:
            lines.append(f"- removed {kind}: {key}")
        elif base[key] != head[key]:
            for attribute in sorted(set(base[key]) | set(head[key])):
                old, new = base[key].get(attribute), head[key].get(attribute)
                if old != new:
                    lines.append(f"~ changed {kind}: {key}: {attribute} {fmt(old)} -> {fmt(new)}")
    return lines


def diff(base_workspace, head_workspace):
    """Return the list of model differences, one human-readable line each."""
    base_elements, base_relationships = normalise(base_workspace)
    head_elements, head_relationships = normalise(head_workspace)
    return diff_section("element", base_elements, head_elements) + diff_section(
        "relationship", base_relationships, head_relationships
    )


def main(argv):
    if len(argv) != 3:
        print("usage: model-diff BASE.json HEAD.json", file=sys.stderr)
        return 2
    try:
        workspaces = []
        for path in argv[1:]:
            with open(path, encoding="utf-8") as f:
                workspaces.append(json.load(f))
    except (OSError, ValueError) as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    changes = diff(*workspaces)
    if not changes:
        print("Model unchanged.")
        return 0
    print(f"Model changed: {len(changes)} difference(s).")
    for line in changes:
        print(line)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
